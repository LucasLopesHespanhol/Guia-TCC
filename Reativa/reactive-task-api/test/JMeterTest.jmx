          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="JSR223 Assertion" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">def tarefa = new groovy.json.JsonSlurper()
    .parseText(prev.getResponseDataAsString())

assert tarefa.id.toString() == vars.get(&apos;taskId&apos;)
assert tarefa.titulo == &apos;Load pilot&apos;
assert tarefa.descricao == &apos;Controlled CRUD cycle&apos;
assert tarefa.prioridade == &apos;MEDIA&apos;
assert tarefa.status == &apos;ABERTA&apos;
assert tarefa.dataLimite == &apos;2020-01-15&apos;</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
          </JSR223Assertion>
          <hashTree/>
        </hashTree>
