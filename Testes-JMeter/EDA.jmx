    <hashTree>
      <JSR223Listener guiclass="TestBeanGUI" testclass="JSR223Listener" testname="Contar operacoes no relatorio">
        <stringProp name="scriptLanguage">groovy</stringProp>
        <stringProp name="parameters"></stringProp>
        <stringProp name="filename"></stringProp>
        <stringProp name="cacheKey">true</stringProp>
        <stringProp name="script">def r = sampleResult
def msg = r.getResponseMessage()
if (msg != null &amp;&amp; msg.startsWith(&apos;Number of samples in transaction&apos;)) {
    r.setResponseMessage(msg.replace(&apos;Number of samples in transaction&apos;, &apos;Operacao EDA - subamostras&apos;))
    r.removeSubResults()
}</stringProp>
      </JSR223Listener>
      <hashTree/>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="EDA">
        <intProp name="ThreadGroup.num_threads">5000</intProp>
        <intProp name="ThreadGroup.ramp_time">5</intProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
        <stringProp name="ThreadGroup.on_sample_error">stopthread</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller">
