              <hashTree/>
              <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="JSR223 Assertion" enabled="true">
                <stringProp name="scriptLanguage">groovy</stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="script">    String estado = vars.get(&apos;estado&apos;)
    int tentativa = (vars.get(&apos;__jm__Espera__idx&apos;) ?: &apos;0&apos;) as int
    if (estado == &apos;REGISTRADA&apos; &amp;&amp; tentativa &gt;= 299) {
        estado = &apos;PRAZO_ESGOTADO&apos;
        vars.put(&apos;estado&apos;, estado)          // encerra o While
    }
    if (estado != &apos;REGISTRADA&apos; &amp;&amp; estado != &apos;CONCLUIDA&apos;) {
        AssertionResult.setFailure(true)
        AssertionResult.setFailureMessage(&apos;Operacao nao concluida: &apos; + estado)
    }</stringProp>
              </JSR223Assertion>
